# Local Supabase stack (Docker) — used by `npm run dev:local`.
# Copy to `.env.docker` and fill from the output of `supabase start`.
#
# Only the Supabase + database values live here. Shared keys (OpenFIGI,
# Anthropic, …) stay in `.env.local` and are merged in automatically — values
# set here take precedence over `.env.local`, so the same shared keys work in
# both cloud and local modes.

# From `supabase start` → "API URL"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# From `supabase start` → "anon key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From `supabase start` → "service_role key"
SUPABASE_SERVICE_ROLE_KEY=

# From `supabase start` → "DB URL" (local Postgres in Docker)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
