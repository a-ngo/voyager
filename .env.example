# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Server only — never NEXT_PUBLIC_

# Database (Drizzle) — Supabase Postgres connection string, server only.
# Transaction pooler URI (port 6543) from Supabase → Project Settings → Database.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres

# AI
ANTHROPIC_API_KEY=your_key_here                        # Server only — never NEXT_PUBLIC_
OLLAMA_BASE_URL=                                        # Optional — local model endpoint, defaults to http://localhost:11434/v1

# Prices
OPENFIGI_API_KEY=                                      # Optional — raises OpenFIGI ISIN→symbol resolution rate limits

# Email
RESEND_API_KEY=your_resend_key_here                    # Server only

# Cron
CRON_SECRET=your_cron_secret_here                      # Secures cron job endpoints
