# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Server only — never NEXT_PUBLIC_

# AI
ANTHROPIC_API_KEY=your_key_here                        # Server only — never NEXT_PUBLIC_

# Prices
YAHOO_FINANCE_PROXY_URL=                               # Optional, if using a proxy

# Email
RESEND_API_KEY=your_resend_key_here                    # Server only

# Cron
CRON_SECRET=your_cron_secret_here                      # Secures cron job endpoints
